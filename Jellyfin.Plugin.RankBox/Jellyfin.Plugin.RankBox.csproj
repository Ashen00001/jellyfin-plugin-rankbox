<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.RankBox</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.RankBox</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <JellyfinVersion>12.1.0</JellyfinVersion>
    <!-- On a machine with Jellyfin installed, compile against that exact install.
         Anywhere else (GitHub Actions), use the official Jellyfin NuGet packages. -->
    <JellyfinDir Condition="'$(JellyfinDir)' == ''">C:\Program Files\Jellyfin\Server</JellyfinDir>
    <UseNuget Condition="'$(UseNuget)' == '' And !Exists('$(JellyfinDir)\MediaBrowser.Controller.dll')">true</UseNuget>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuget)' != 'true'">
    <Reference Include="MediaBrowser.Controller"><HintPath>$(JellyfinDir)\MediaBrowser.Controller.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>$(JellyfinDir)\MediaBrowser.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(JellyfinDir)\MediaBrowser.Model.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Data"><HintPath>$(JellyfinDir)\Jellyfin.Data.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Database.Implementations"><HintPath>$(JellyfinDir)\Jellyfin.Database.Implementations.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jellyfin.Extensions"><HintPath>$(JellyfinDir)\Jellyfin.Extensions.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(JellyfinDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(UseNuget)' == 'true'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\app.html" />
    <EmbeddedResource Include="Web\notify.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
